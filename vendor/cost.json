  "copy": {
    "landing": {
      "eyebrow": "Free assessment",
      "title": "How ready is your organisation to control its cloud costs?",
      "body": "Answer 20 short questions about how you track, size, and govern your cloud infrastructure. You will get a readiness score, your biggest opportunity area, and three practical next steps.",
      "meta": [
        "Takes 4–6 minutes",
        "No cloud credentials needed",
        "Works for AWS, Azure, Contabo, and on-premises"
      ],
      "start": "Start the assessment"
    },
    "result": {
      "intro": "Your Cloud Optimisation Readiness Score shows how prepared your organisation is to understand, control, and continuously reduce cloud infrastructure costs.",
      "disclaimer": "This result is based on your answers and is not a billing audit. A precise savings estimate requires provider billing and utilisation data.",
      "primary_heading": "Your biggest opportunity",
      "secondary_heading": "Also worth reviewing",
      "actions_heading": "Three things to do next",
      "cta": "Book a cloud optimisation strategy session",
      "cta_support": "Discuss your result with our team and identify the highest-value next steps for your AWS, Contabo, Azure, or other infrastructure environment.",
      "email_heading": "Your full report is on its way",
      "email_body_email": "We have sent the complete breakdown to {contact} — every finding, the reasoning behind it, and the three things to do first.",
      "email_hint": "It usually arrives within a minute. If it does not, check your spam folder before assuming it went missing.",
      "email_failed_heading": "We could not send your report",
      "email_failed_body": "Your answers and your score are saved, so nothing is lost. Book the session below and we will bring the full breakdown with us."
    },
    "consent_note": "We will only email or message you beyond this result if you tick the box below.",
    "findings": {
      "visibility_and_allocation": {
        "title": "Cloud-spend visibility and allocation",
        "body": "Your biggest opportunity is improving cloud-spend visibility and ownership. Begin with billing reports, application or team allocation, tagging, budgets, and regular cost reviews.",
        "actions": [
          "Turn on detailed billing reports and give one named person responsibility for reviewing them.",
          "Agree a tagging standard for application, team, and environment, then apply it to existing resources.",
          "Put a recurring 30-minute cost review in the calendar, with the bill broken down by application."
        ]
      },
      "idle_resource_review": {
        "title": "Idle, unused, and oversized resources",
        "body": "Your answers indicate a likely opportunity to identify idle, unused, or oversized resources. A technical review should examine compute, storage, snapshots, databases, load balancers, and non-production environments.",
        "actions": [
          "List every running resource and flag anything averaging under 20% utilisation over the last 30 days.",
          "Delete unattached disks, old snapshots, unused IP addresses, and idle load balancers.",
          "Schedule automatic shutdown for development and staging environments outside working hours."
        ]
      },
      "scaling_optimisation": {
        "title": "Matching capacity to demand",
        "body": "Your infrastructure may be able to reduce cost by matching capacity to demand. Review autoscaling, scheduled shutdowns, caching, queues, CDN usage, and asynchronous processing.",
        "actions": [
          "Establish your true peak and baseline demand from the last 90 days of metrics.",
          "Introduce autoscaling or scheduled scaling for the workloads with the clearest daily pattern.",
          "Put caching or a CDN in front of your most requested read-heavy endpoints."
        ]
      },
      "storage_network_optimisation": {
        "title": "Storage, backup, and data transfer",
        "body": "Review storage lifecycle policies, backup and snapshot retention, logs, internet egress, cross-region traffic, CDN usage, and gateway-related charges.",
        "actions": [
          "Set lifecycle rules that tier older objects down and expire what no longer needs keeping.",
          "Check backup and snapshot retention against what you are actually required to keep.",
          "Break data-transfer charges down by egress, cross-region traffic, and NAT or gateway costs."
        ]
      },
      "commitment_optimisation": {
        "title": "Pricing commitments",
        "body": "Analyse stable workloads before purchasing or renewing reservations, Savings Plans, or equivalent provider commitments.",
        "actions": [
          "Establish your steady-state baseline from at least 90 days of usage.",
          "Model flexible commitments against that baseline before committing to anything term-locked.",
          "Diarise a review before each commitment renews, rather than after."
        ]
      },
      "governance": {
        "title": "Cost governance and ownership",
        "body": "Establish budgets, anomaly alerts, cost ownership, tagging standards, approval thresholds, and a recurring optimisation review.",
        "actions": [
          "Set budgets for the organisation and for each significant workload, alerting before the limit.",
          "Turn on automated anomaly alerts so cost spikes surface in days rather than on the invoice.",
          "Add an expected-cost line to the checklist for new infrastructure and features."
        ]
      },
      "continuous_improvement": {
        "title": "Continuous improvement",
        "body": "Your answers show strong cost practices across visibility, utilisation, scaling, storage, pricing commitments, and governance. The next opportunities are usually advanced ones: unit economics, architectural efficiency, and keeping commitments aligned as workloads change. Cloud costs drift as systems grow, so this is a position to maintain rather than a finished state.",
        "actions": [
          "Move from total cost to unit economics: cost per customer, per transaction, or per tenant.",
          "Re-check commitment coverage against how the workload has changed this quarter.",
          "Review your three largest line items for architectural rather than configuration savings."
        ]
      },
      "managed_optimisation": {
        "title": "A structured audit may be the right next step",
        "body": "Your answers suggest that a structured cloud-cost audit and recurring optimisation review may be valuable. Use the strategy session to define the right scope.",
        "actions": []
      }
    },
    "email": {
      "product": "Cloud Optimisation Assessment",
      "score_label": "Cloud Optimisation Readiness Score",
      "report_line": "Here is your full Cloud Optimisation Readiness report.",

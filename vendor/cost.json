  "sections": [
    {
      "n": 1,
      "title": "Organisation and cloud profile",
      "kicker": "Context first",
      "body": "Nothing in this section is scored. These answers decide how everything after them should be read — a four-person startup and a regulated bank can post the same score and need opposite first moves.",
      "focus": "Who you are and what you run",
      "question_count": 3,
      "points": 0
    },
    {
      "n": 2,
      "title": "Spend visibility and ownership",
      "kicker": "Where it all starts",
      "body": "Everything downstream depends on this. You cannot right-size what you cannot see, and you should not commit to a year of capacity before you know what you are running. Score badly here and we will hold back advice that would otherwise be premature.",
      "focus": "Seeing the bill, and owning it",
      "question_count": 4,
      "points": 15
    },
    {
      "n": 3,
      "title": "Resource utilisation and waste",
      "kicker": "The fastest money",
      "body": "Spend on things that are running but not working: servers at 4% CPU, disks from machines deleted last year, staging environments awake all weekend. None of it needs re-architecting, and it usually shows up on the next invoice.",
      "focus": "Paying for what nobody uses",
      "question_count": 4,
      "points": 20
    },
    {
      "n": 4,
      "title": "Scaling and architecture efficiency",
      "kicker": "The structural kind",
      "body": "The last section asked whether you pay for things you do not use. This one asks whether your architecture forces you to. An estate that cannot scale survives its busiest hour by running at that size all year round.",
      "focus": "What your architecture costs you",
      "question_count": 3,
      "points": 15
    },
    {
      "n": 5,
      "title": "Pricing, storage, and data transfer",
      "kicker": "Three different animals",
      "body": "Costs that behave nothing like compute. Commitments are the largest discount available anywhere in cloud. Storage and data transfer share a quieter problem — both grow steadily without anyone ever deciding they should.",
      "focus": "Discounts, retention, and egress",
      "question_count": 3,
      "points": 15
    },
    {
      "n": 6,
      "title": "Governance and optimisation process",
      "kicker": "Does it last?",
      "body": "This section predicts the future rather than describing the present. Everything before it can be fixed in one engagement. Only this decides whether the saving is still there in a year.",
      "focus": "Whether the fix survives",
      "question_count": 3,
      "points": 15
    }
  ],
